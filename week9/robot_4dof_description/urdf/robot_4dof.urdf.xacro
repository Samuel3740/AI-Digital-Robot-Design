<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_4dof">

  <!-- 관절 회전 제한, 링크 기본 치수 설정 -->
  <!-- rad/2 := 1.5708로 정의 -->
  <xacro:property name="joint_limit" value="1.5708"/>

  <xacro:property name="base_length" value="0.1"/>
  <xacro:property name="base_radius" value="0.1"/>
  <xacro:property name="base_mass" value="1.0"/>

  <xacro:property name="link_length" value="0.2"/>
  <xacro:property name="link_radius" value="0.03"/>
  <xacro:property name="link_mass" value="0.5"/>

  <!-- 링크별 정의 -->
  <material name="grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.2 0.7 0.35 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.95 0.8 0.15 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.85 0.2 0.2 1.0"/>
  </material>

  <!-- 링크 생성  -->
  <xacro:macro name="cylinder_link" params="name length radius mass color">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${color}"/>
      </visual>

      <collision>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- 베이스 및 링크 생성 -->
  <xacro:cylinder_link name="base_link" length="${base_length}" radius="${base_radius}" mass="${base_mass}" color="grey"/>
  <xacro:cylinder_link name="link1" length="${link_length}" radius="${link_radius}" mass="${link_mass}" color="blue"/>
  <xacro:cylinder_link name="link2" length="${link_length}" radius="${link_radius}" mass="${link_mass}" color="green"/>
  <xacro:cylinder_link name="link3" length="${link_length}" radius="${link_radius}" mass="${link_mass}" color="yellow"/>
  <xacro:cylinder_link name="link4" length="${link_length}" radius="${link_radius}" mass="${link_mass}" color="red"/>

  <!-- joint 정의 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${joint_limit}" upper="${joint_limit}" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${joint_limit}" upper="${joint_limit}" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${joint_limit}" upper="${joint_limit}" effort="10.0" velocity="1.0"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${link_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${joint_limit}" upper="${joint_limit}" effort="10.0" velocity="1.0"/>
  </joint>

</robot>
